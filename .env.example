# --- Application -------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=paybull

DB_SYNCHRONIZE=false

DB_SSL=false
DB_LOGGING=false

# --- CORS --------------------------------------------------------------------
# Empty = disabled. `*` = any origin. Otherwise a comma-separated list:
# CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=

# Must not be combined with CORS_ORIGIN=* — browsers reject credentialed
# requests answered with a wildcard origin.
CORS_CREDENTIALS=false

# --- Client IP ---------------------------------------------------------------
# Express `trust proxy`. Needed for req.ip to hold the real client address when
# the app sits behind a proxy or load balancer.
#   false      off — req.ip is the direct peer
#   true       trust every proxy in the chain
#   <number>   trust this many hops (e.g. 1 behind a single nginx)
#   loopback   trust local addresses only
TRUST_PROXY=false

# --- JWT ---------------------------------------------------------------------
# Three independent secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=2592000

# Signs the short-lived token that carries registration from step 1 to step 2.
JWT_REGISTRATION_SECRET=
JWT_REGISTRATION_TTL_SECONDS=900

# Lifetime of the token that carries a self-service email addition from
# POST /users/me/email to POST /users/me/email/confirm. It is signed with
# JWT_REGISTRATION_SECRET and carries the pending address together with the
# hash of the 6-digit code that was mailed out — the address is not written
# to the users table until the code comes back.
EMAIL_CONFIRMATION_TTL_SECONDS=900

# --- Password recovery -------------------------------------------------------
# How long a recovery code stays usable. Five wrong guesses also spend it.
PASSWORD_RESET_TTL_MINUTES=15

# Optional. The frontend origin the recovery link points at. The link carries
# the same 6-digit code the message shows — there is no second secret:
#   {APP_URL}/reset-password?login=...&code=...
# Empty means no link is built at all — the recovery email then carries the
# code only, and says so. No URL is invented in its place.
APP_URL=

# --- One-time login links ----------------------------------------------------
# How long a login link a superadmin issues for an account stays usable.
# Whoever opens the link gets an ordinary session of that account, without its
# password or second factor, so keep this short: 1 to 60 minutes, anything
# larger aborts startup. The link is single-use, and
# issuing a new one for the same account kills the previous unused one. With
# APP_URL set it points at:
#   {APP_URL}/login-link#code=...
# The code is in the fragment so it never reaches a server log or a Referer.
# With APP_URL empty only the code is returned.
LOGIN_LINK_TTL_MINUTES=15

# --- Login footprints --------------------------------------------------------
# Optional. Path to a DB-IP Lite Country database in .mmdb format
# (https://db-ip.com/db/download/ip-to-country-lite, CC BY 4.0). It is opened
# once at startup and used to put a country on each login footprint; nothing is
# sent anywhere. Empty, a missing file or an unreadable one means no country is
# resolved (a warning is logged when a path is set but cannot be opened); the
# application still starts. DB-IP publishes a new file monthly.
GEOIP_DB_PATH=

# --- Two-factor authentication -----------------------------------------------
# Shown as the account issuer in Google Authenticator.
TOTP_ISSUER=Paybull

# --- Invites -----------------------------------------------------------------
INVITE_TTL_HOURS=72

# --- Bank details ------------------------------------------------------------
# Required, no default: the minimum amount of a counterparty-only requisite, in
# fiat, kopecks allowed (up to two decimals). An empty value aborts startup.
COUNTERPARTY_MIN_AMOUNT=

# --- Devices (the phone app) -------------------------------------------------
# How long the QR code of POST /devices/:id/pairing stays usable. It is single
# use, and issuing a new one voids the previous unused one.
DEVICE_PAIRING_TTL_MINUTES=10
# How often the app is told to call POST /device/heartbeat (returned on pairing).
DEVICE_HEARTBEAT_SECONDS=30
# A device is online while its last heartbeat is no older than this.
DEVICE_ONLINE_WINDOW_SECONDS=120

# --- Exchange rate -----------------------------------------------------------
RATE_MARKUP=0.01
# Required, no default: the minimum percent the platform keeps on every deal
# after the lead shares (up to three decimals). An empty value aborts startup.
# A method may override it in the registry (platformMinPercent).
PLATFORM_MIN_PERCENT=
RAPIRA_RATE_URL=https://api.rapira.net/open/market/rates
RAPIRA_RATE_SYMBOL=USDT/RUB
RAPIRA_RATE_TTL_SECONDS=60

# --- Deals --------------------------------------------------------------------
# How many minutes a deal has to be paid, counted from its creation. A
# merchant's own payment window (merchant settings) overrides it for that
# merchant's pay-in and pay-out deals. A deal still pending or active when the
# time is up is canceled by the system; checking, checking_manually,
# manual_review and dispute never expire. The deadline is set once and never
# moves. An empty value aborts startup rather than reading as zero.
DEAL_TTL_MINUTES=15
TRADER_EXPORT_MAX_ROWS=100000
PAYOUT_PAYMENT_WINDOW_MINUTES=60
PAYOUT_REVIEW_MINUTES=1440
PAYOUT_MAX_ACTIVE_PER_TRADER=3
PAYOUT_INSURANCE_HOLD_MINUTES=120

APPEAL_TRADER_RESPONSE_MINUTES=30
APPEAL_NIGHT_START_HOUR=0
APPEAL_NIGHT_END_HOUR=10
APPEAL_NIGHT_GRACE_MINUTES=30
PAYOUT_APPEAL_RESPONSE_HOURS=12
DISPUTE_FILES_MAX=5

MERCHANT_CALLBACK_TIMEOUT_MS=10000
MERCHANT_CALLBACK_MAX_ATTEMPTS=10
MERCHANT_CALLBACK_INTERVAL_SECONDS=5
MERCHANT_CALLBACK_CONCURRENCY=10
MERCHANT_CALLBACK_RETENTION_DAYS=90

# Files of deals (pay-out receipts). Required: S3-compatible storage, MinIO locally
# (docker compose up -d minio). The bucket is private and created on first start.
DISPUTE_FILE_MAX_BYTES=52428800
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=paybull
S3_ACCESS_KEY_ID=paybull-local
S3_SECRET_ACCESS_KEY=paybull-local-secret
S3_FORCE_PATH_STYLE=true
# How often the job looks for pending/active deals whose deadline has passed.
DEAL_EXPIRY_INTERVAL_SECONDS=30

# --- Trader balances ---------------------------------------------------------
MAIN_BALANCE_MIN_THRESHOLD=0

# --- Insurance deposit -------------------------------------------------------
INSURANCE_PAY_IN_MIN=500
# Required, no default: the global minimum insurance pay-out deposit (up to six
# decimals, like every amount of money). An empty value aborts startup. A
# trader may have a personal minimum.
INSURANCE_PAY_OUT_MIN=
INSURANCE_WITHDRAWAL_DELAY_DAYS=14
INSURANCE_NIGHT_START_HOUR=0
INSURANCE_NIGHT_END_HOUR=10

# --- Night stop --------------------------------------------------------------
# Inside its own window, a trader with at least NIGHT_STOP_THRESHOLD open
# disputes (1-10) is paused for new pay-in deals. Separate hours from
# INSURANCE_NIGHT_*; both windows read their hours in BUSINESS_TIMEZONE.
NIGHT_STOP_THRESHOLD=2
NIGHT_STOP_START_HOUR=0
NIGHT_STOP_END_HOUR=10

# --- Business calendar -------------------------------------------------------
# The one timezone of the whole system (an IANA name): the hours of both night
# windows above, "today" and "this month" in requisite turnover, the analytics
# days, the merchants' volume period and a date-only createdFrom/createdTo.
BUSINESS_TIMEZONE=Europe/Moscow

# --- Mail (SMTP) -------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
# true for implicit TLS (port 465), false for STARTTLS.
MAIL_SECURE=false
# Empty user = connect without authentication (local mail catchers).
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- Audit archive (VictoriaLogs) --------------------------------------------
# Every audit row is written to Postgres first. When VICTORIA_LOGS_URL is set,
# a periodic job ships rows to VictoriaLogs in id order, marks them archived,
# and deletes archived rows older than AUDIT_RETENTION_DAYS from Postgres.
# GET /admin/audit then reads both stores as one list.
# Empty = archival disabled; rows stay in Postgres and reads come from there.
# For the local instance from docker-compose.yml use:
#   VICTORIA_LOGS_URL=http://localhost:9428
VICTORIA_LOGS_URL=
AUDIT_ARCHIVE_INTERVAL_SECONDS=300
AUDIT_ARCHIVE_BATCH_SIZE=1000
AUDIT_RETENTION_DAYS=30

# --- Merchant API request log («История запросов») ---------------------------
# Every /v1 request of an identified merchant is written to merchant_api_requests,
# the X-Secure-Key masked and Authorization / Cookie dropped. Request and response
# bodies longer than MERCHANT_REQUEST_LOG_MAX_BYTES are cut and flagged truncated.
# With VICTORIA_LOGS_URL set a job on the audit archive's interval and batch size
# ships the rows to VictoriaLogs and deletes archived rows older than
# MERCHANT_REQUEST_RETENTION_DAYS from Postgres; empty keeps them in Postgres.
MERCHANT_REQUEST_RETENTION_DAYS=30
MERCHANT_REQUEST_LOG_MAX_BYTES=65536

# --- Payment page (MA11) -----------------------------------------------------
# Optional. The frontend page a payer of a /v1 pay-in is sent to:
#   {PAYMENT_PAGE_URL}/{token}
# The token is random, issued with the deal, and is not the deal id. Empty means
# paymentPageUrl is null in every answer; GET /pay/{token} still serves a token.
PAYMENT_PAGE_URL=
# The public /pay/* endpoints take at most this many requests per client IP per
# minute (in memory, per instance); above it they answer 429. TRUST_PROXY decides
# which address is the client's.
PAY_PAGE_RATE_LIMIT_PER_MINUTE=60
# After a deal reaches a final status its page keeps answering GET /pay/{token}
# for this many hours, showing the result and the merchant's success/error URLs;
# «Я оплатил» and receipts close at once. 0 closes the page at the final status.
PAYMENT_PAGE_FINAL_TTL_HOURS=24

# Requisite selection journals one selection_attempts row per requisite it tried
# (issued, or skipped under lock); an hourly job deletes rows older than this.
SELECTION_ATTEMPTS_RETENTION_DAYS=30

# --- Debts --------------------------------------------------------------------
# How often the job looks for debts whose auto write-off moment has passed and
# withholds their whole remaining amount from the debtor's main balance.
DEBT_AUTO_WRITE_OFF_INTERVAL_SECONDS=60

# --- Tron engine (USDT TRC-20) -----------------------------------------------
# Required: the application does not start without the engine. Everything goes
# through TronGrid (an API key is required) on the chosen network.
TRON_NETWORK=
# e.g. https://api.trongrid.io (mainnet) or https://nile.trongrid.io (testnet)
TRON_API_URL=
TRON_API_KEY=
# USDT contract on the chosen network (base58, T...).
TRON_USDT_CONTRACT=

# Where the HD seed of the deposit addresses and the private keys of the hot
# and energy wallets come from: vault (default) or env.
KEY_SOURCE=vault

# KEY_SOURCE=vault: the three are Vault Transit ciphertexts (vault:v1:...),
# decrypted only for a signature; Vault is entered with AppRole. Keys never sit
# in the database or in plain configuration.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TRANSIT_KEY=
TRON_DEPOSIT_SEED_CIPHERTEXT=
TRON_HOT_KEY_CIPHERTEXT=
TRON_ENERGY_KEY_CIPHERTEXT=

# KEY_SOURCE=env: local development only, no Vault needed. The keys are written
# here in plain text: a BIP-39 mnemonic and two 64-hex private keys. Refused at
# startup when NODE_ENV=production. Use testnet keys only.
TRON_DEPOSIT_MNEMONIC=
TRON_HOT_PRIVATE_KEY=
TRON_ENERGY_PRIVATE_KEY=

TRON_SCAN_INTERVAL_SECONDS=3
TRON_SCAN_BATCH_BLOCKS=100
# Lag behind the last solidified block above which every scan tick warns.
TRON_SCAN_MAX_LAG_BLOCKS=200
TRON_CHAIN_PARAMS_TTL_SECONDS=600
# How often outgoing transactions are checked for their final state.
TRON_CONFIRM_INTERVAL_SECONDS=10
# Required: the most TRX one transaction may burn (its fee_limit), up to six
# decimals. Every TRC-20 transaction carries one.
TRON_MAX_TRX_BURN_PER_TX=

# --- Sweep (deposit addresses -> master wallet) ------------------------------
# Required: an address is swept once it holds at least this much USDT ...
SWEEP_MIN_USDT=
# ... or this long after its last incoming transfer.
SWEEP_MAX_IDLE_HOURS=24
SWEEP_INTERVAL_SECONDS=300
SWEEP_BATCH_SIZE=20
# Required: what a sweep does when the platform has no staked energy to
# delegate. true = burn TRX (sent to the deposit address for the fee, capped by
# TRON_MAX_TRX_BURN_PER_TX); false = wait for energy. Without a stake only
# true sweeps at all.
SWEEP_BURN_WHEN_NO_ENERGY=

# Required: the Rapira pair that prices TRX in USDT (the withdrawal fee quote).
RAPIRA_TRX_RATE_SYMBOL=
TRX_RATE_TTL_SECONDS=60

# --- Deposits ----------------------------------------------------------------
# Required: the window a deposit request shows the trader, in minutes. Any
# transfer to the trader's permanent address is credited whenever it arrives.
DEPOSIT_WINDOW_MINUTES=
# Required: transfers below this accumulate until their sum reaches it.
DEPOSIT_MIN_USDT=
# Required: how many live deposit requests a trader may hold at once.
DEPOSIT_MAX_ACTIVE_REQUESTS=
DEPOSIT_EXPIRY_INTERVAL_SECONDS=30

# --- Withdrawals -------------------------------------------------------------
# Required: the smallest withdrawal, and the most a trader may withdraw in 24 h.
WITHDRAWAL_MIN_USDT=
WITHDRAWAL_DAILY_LIMIT_USDT=
# Required: the same two for a merchant's withdrawal request from its cabinet
# (an admin pays it by hand); the 24 h limit counts every account of the merchant.
MERCHANT_WITHDRAWAL_MIN_USDT=
MERCHANT_WITHDRAWAL_DAILY_LIMIT_USDT=
# Required: hours after a password change or a second-factor reset during
# which a withdrawal is refused.
WITHDRAWAL_SECURITY_HOLD_HOURS=
# Required: how long a withdrawal fee quote stays valid, in seconds.
WITHDRAWAL_QUOTE_TTL_SECONDS=
# Required: auto = a request is sent on the next queue tick; manual = only an
# admin pays (by hash). Switching needs a restart; manual is the emergency stop.
PAYOUT_MODE=
PAYOUT_INTERVAL_SECONDS=15
PAYOUT_BATCH_SIZE=10
# A withdrawal processing longer than this is reported as stale.
PAYOUT_STALE_MINUTES=30
# A withdrawal TOTP is spent once; this many wrong codes inside this many
# minutes lock withdrawals of the account until the window passes (429).
WITHDRAWAL_TOTP_MAX_FAILURES=5
WITHDRAWAL_TOTP_LOCK_MINUTES=15
