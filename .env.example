# --- Application -------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=paybull

DB_SYNCHRONIZE=false

DB_SSL=false
DB_LOGGING=false

# --- CORS --------------------------------------------------------------------
# Empty = disabled. `*` = any origin. Otherwise a comma-separated list:
# CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=

# Must not be combined with CORS_ORIGIN=* — browsers reject credentialed
# requests answered with a wildcard origin.
CORS_CREDENTIALS=false

# --- Client IP ---------------------------------------------------------------
# Express `trust proxy`. Needed for req.ip to hold the real client address when
# the app sits behind a proxy or load balancer.
#   false      off — req.ip is the direct peer
#   true       trust every proxy in the chain
#   <number>   trust this many hops (e.g. 1 behind a single nginx)
#   loopback   trust local addresses only
TRUST_PROXY=false

# --- JWT ---------------------------------------------------------------------
# Three independent secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=2592000

# Signs the short-lived token that carries registration from step 1 to step 2.
JWT_REGISTRATION_SECRET=
JWT_REGISTRATION_TTL_SECONDS=900

# Lifetime of the token that carries a self-service email addition from
# POST /users/me/email to POST /users/me/email/confirm. It is signed with
# JWT_REGISTRATION_SECRET and carries the pending address together with the
# hash of the 6-digit code that was mailed out — the address is not written
# to the users table until the code comes back.
EMAIL_CONFIRMATION_TTL_SECONDS=900

# --- Password recovery -------------------------------------------------------
# How long a recovery code stays usable. Five wrong guesses also spend it.
PASSWORD_RESET_TTL_MINUTES=15

# Optional. The frontend origin the recovery link points at. The link carries
# the same 6-digit code the message shows — there is no second secret:
#   {APP_URL}/reset-password?login=...&code=...
# Empty means no link is built at all — the recovery email then carries the
# code only, and says so. No URL is invented in its place.
APP_URL=

# --- Two-factor authentication -----------------------------------------------
# Shown as the account issuer in Google Authenticator.
TOTP_ISSUER=Paybull

# --- Invites -----------------------------------------------------------------
INVITE_TTL_HOURS=72

# --- Mail (SMTP) -------------------------------------------------------------
# Optional. Empty MAIL_HOST disables outgoing mail entirely: the app still boots and
# invites are still created, they are just not delivered — the admin hands the code
# over by other means (it is visible in POST/GET /admin/invites).
# When MAIL_HOST is set, MAIL_FROM becomes required.
MAIL_HOST=
MAIL_PORT=587
# true for implicit TLS (port 465), false for STARTTLS.
MAIL_SECURE=false
# Empty user = connect without authentication (local mail catchers).
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
