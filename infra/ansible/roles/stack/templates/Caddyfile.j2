{
	email {{ paybull_acme_email }}
}

{{ paybull_api_domain }} {
	encode zstd gzip
	request_body /pay/* {
		max_size {{ (stack_env.DISPUTE_FILE_MAX_BYTES | default(52428800) | int) + 65536 }}
	}
	reverse_proxy backend:3000
}

{{ paybull_front_domain }} {
	encode zstd gzip
	root * /srv/front
	try_files {path} /index.html
	file_server
}
